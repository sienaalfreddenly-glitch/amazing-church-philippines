# Copy to deploy/.env and fill in. deploy/.env is gitignored; never commit it.

# The public HTTPS origin Tailscale Funnel serves, with no trailing slash.
# This is baked into the client bundle, so changing it means rebuilding:
#   docker compose -f deploy/docker-compose.yml --env-file deploy/.env up -d --build
PUBLIC_ORIGIN=https://aytz.tailcc79ac.ts.net

# Same keys the local .env.local already uses. Copy them across.
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

FACEBOOK_PAGE_URL=https://www.facebook.com/amazingchurchphilippines
ESV_API_KEY=
