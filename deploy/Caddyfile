# ngrok terminates TLS and forwards plain HTTP to this port, so Caddy serves
# HTTP only. Do not expose this port to the internet directly.
http://:8091 {
	encode zstd gzip

	# Supabase is served under a path on the same public origin rather than a
	# second hostname. handle_path strips the /supabase prefix, so a browser
	# call to https://<host>/supabase/auth/v1/token reaches Kong as
	# /auth/v1/token. Keeping one origin also keeps auth cookies first-party.
	handle_path /supabase/* {
		# Kong is published on the host by the Supabase stack, which runs in its
		# own compose project on a different Docker network.
		reverse_proxy host.docker.internal:54321 {
			# Realtime upgrades to a websocket; Caddy proxies that natively.
			header_up Host {upstream_hostport}
		}
	}

	# Supabase's own API paths, accepted at the root as well as under /supabase.
	#
	# The Vercel deployment was built with NEXT_PUBLIC_SUPABASE_URL set to the
	# bare domain, so its browser calls arrive as /auth/v1/token rather than
	# /supabase/auth/v1/token and were being handed to Next.js, which answered
	# 404 and showed the reader "Failed to fetch". Routing these prefixes to
	# Kong as well makes both address shapes work, so the site is correct
	# whichever build a visitor loaded.
	#
	# Safe because the application owns no route under any of these prefixes.
	# handle, not handle_path: Kong expects the full path here.
	@supabase_api path /auth/v1/* /rest/v1/* /storage/v1/* /realtime/v1/* /functions/v1/*
	handle @supabase_api {
		reverse_proxy host.docker.internal:54321 {
			header_up Host {upstream_hostport}
		}
	}

	handle {
		reverse_proxy app:3000
	}

	log {
		output stdout
		format console
	}
}
